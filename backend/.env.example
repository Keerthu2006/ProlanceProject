# ================================================================
#  TriGrowth AI – Environment Variables Template
#  Copy to .env and fill in your actual values.
#  NEVER commit the real .env to version control.
# ================================================================

# ── Application ──────────────────────────────────────────────────
APP_PROFILE=local
SERVER_PORT=8080

# ── PostgreSQL ───────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/trigrowth_ai
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# ── Redis ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── RabbitMQ ─────────────────────────────────────────────────────
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASS=guest

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-very-long-random-secret-key-min-32-chars

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── OpenAI / Spring AI ───────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── AI Micro-service ─────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001

# ── AWS S3 ───────────────────────────────────────────────────────
AWS_S3_BUCKET=trigrowth-ai-uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# ── Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Mail ─────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@trigrowth.ai
MAIL_PASSWORD=
